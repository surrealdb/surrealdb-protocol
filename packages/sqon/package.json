{
    "name": "@surrealdb/sqon",
    "version": "0.1.3",
    "type": "module",
    "license": "Apache-2.0",
    "description": "SQON value types and codecs for SurrealDB.",
    "homepage": "https://github.com/surrealdb/surrealdb-protocol",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/surrealdb/surrealdb-protocol.git",
        "directory": "packages/sqon"
    },
    "scripts": {
        "build": "bun run build.ts",
        "bench": "bun run src/codec/text/parser.bench.ts",
        "qc": "biome check .",
        "qa": "biome check . --write",
        "qau": "biome check . --write --unsafe"
    },
    "devDependencies": {
        "fast-check": "^4.3.0",
        "mitata": "^1.0.34"
    },
    "peerDependencies": {
        "typescript": "^5.0.0",
        "tslib": "^2.6.3"
    },
    "dependencies": {
        "@surrealdb/cbor": "workspace:*",
        "uuidv7": "^1.0.1"
    },
    "types": "./dist/sqon.d.ts",
    "main": "./dist/sqon.mjs",
    "exports": {
        ".": {
            "types": "./dist/sqon.d.ts",
            "require": "./dist/sqon.cjs",
            "import": "./dist/sqon.mjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
