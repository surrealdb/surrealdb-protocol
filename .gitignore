
# Build
#
# /build and /dist are unanchored below the root because each workspace package
# emits into its own: packages/protocol/build/ts, packages/sqon/dist, and so on.
/build
/plugins
packages/*/build
packages/*/dist
# Written by packages/cbor/build.ts on every build, for the JSR release.
packages/*/jsr.json

