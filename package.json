{
  "name": "surrealdb-protocol",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The SurrealDB Client Protocol: wire schemas, generated bindings, and the value model shared by every SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surrealdb/surrealdb-protocol.git"
  },
  "homepage": "https://github.com/surrealdb/surrealdb-protocol",
  "packageManager": "^bun@1.1.17",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/bun": "1.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "ts": "tsc --watch --noEmit true --emitDeclarationOnly false",
    "qts": "tsc --noEmit",
    "qc": "biome check .",
    "qa": "biome check . --write",
    "qau": "biome check . --write --unsafe"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
