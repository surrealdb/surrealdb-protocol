{
  "name": "@surrealdb/protocol",
  "version": "0.14.0",
  "type": "module",
  "license": "Apache-2.0",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://github.com/surrealdb/surrealdb-protocol/blob/main/LICENSE"
    }
  ],
  "description": "The official SurrealDB Client Protocol for TypeScript.",
  "keywords": [
    "surrealdb",
    "surrealdb-protocol",
    "protobuf",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surrealdb/surrealdb-protocol.git"
  },
  "homepage": "https://github.com/surrealdb/surrealdb-protocol",
  "packageManager": "^bun@1.1.17",
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/bun": "latest",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "^0.25.5",
    "esbuild-plugin-tsc": "^0.5.0",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "rxjs": "^7.8.2",
    "ts-proto": "2.11.5"
  },
  "scripts": {
    "ts": "tsc --watch --noEmit true --emitDeclarationOnly false",
    "qc": "biome check ./typescript/",
    "qa": "biome check ./typescript/ --write",
    "qau": "biome check ./typescript/ --write --unsafe",
    "build": "bun run scripts/build.ts",
    "vectors:write": "bun scripts/vectors.ts write",
    "vectors:check": "bun scripts/vectors.ts check",
    "conformance": "bun conformance/runner/cli.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "./build/ts/index.d.ts",
  "main": "./build/ts/index.cjs",
  "module": "./build/ts/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./build/ts/index.d.ts",
        "default": "./build/ts/index.mjs"
      },
      "require": {
        "types": "./build/ts/index.d.cts",
        "default": "./build/ts/index.cjs"
      }
    }
  },
  "files": [
    "build/ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
